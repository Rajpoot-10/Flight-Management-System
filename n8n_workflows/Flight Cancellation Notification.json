    {
      "parameters": {
        "jsCode": "const refund = $json;\nconst booking = $('Get Cancelled Bookings').item.json;\nconst passenger = $('Get Passenger').item.json;\nconst flight = $('Get Cancelled Flight').first().json;\nconst audit = $('Get Unprocessed Flight Cancellation').first().json;\n\nconst reason =\n  audit.new_data?.reason ||\n  refund.reason ||\n  'Flight cancelled by airline';\n\nreturn [{\n  json: {\n    audit_id: audit.audit_id,\n    booking_id: booking.booking_id,\n    passenger_id: passenger.passenger_id,\n    passenger_name: passenger.full_name,\n    passenger_email: passenger.email,\n    flight_id: flight.flight_id,\n    flight_number: flight.flight_number,\n    origin: flight.origin,\n    destination: flight.destination,\n    departure_time: flight.departure_time,\n    refund_amount: Number(refund.refund_amount || booking.total_amount || 0),\n    refund_status: refund.refund_status || 'pending',\n    cancellation_reason: reason\n  }\n}];"
      },
      "id": "2f448d92-a1dd-49eb-92e2-d8ee34d758a9",
      "name": "Prepare Cancellation Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        480
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.passenger_email }}",
        "subject": "=Flight Cancelled - {{ $json.flight_number }}",
        "message": "=Hello {{ $json.passenger_name }},\\n\\nWe are sorry to inform you that flight {{ $json.flight_number }} from {{ $json.origin }} to {{ $json.destination }} has been cancelled by the airline.\\n\\nReason: {{ $json.cancellation_reason }}\\n\\nBooking ID: {{ $json.booking_id }}\\nRefund amount: PKR {{ $json.refund_amount }}\\nRefund status: {{ $json.refund_status }}\\n\\nYour booking has been cancelled and the refund process has been initiated.\\n\\nFlight Management System",
        "options": {
          "appendAttribution": false
        }
      },
