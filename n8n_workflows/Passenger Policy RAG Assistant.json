      "parameters": {
        "jsCode": "const j = $json;\n\nfunction extractEmail(value) {\n  if (!value) return '';\n\n  if (typeof value === 'string') {\n    const match = value.match(/<([^>]+)>/);\n    return match ? match[1].trim() : value.trim();\n  }\n\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      const found = extractEmail(item);\n      if (found) return found;\n    }\n    return '';\n  }\n\n  if (typeof value === 'object') {\n    if (typeof value.address === 'string') return value.address;\n    if (typeof value.email === 'string') return value.email;\n\n    if (value.value) {\n      const found = extractEmail(value.value);\n      if (found) return found;\n    }\n\n    if (typeof value.text === 'string') {\n      const found = extractEmail(value.text);\n      if (found) return found;\n    }\n\n    for (const v of Object.values(value)) {\n      const found = extractEmail(v);\n      if (found && found.includes('@')) return found;\n    }\n  }\n\n  return '';\n}\n\nconst fromRaw = j.From ?? j.from ?? j.sender ?? '';\n\nreturn [{\n  json: {\n    gmail_message_id: j.id || j.messageId || '',\n    gmail_thread_id: j.threadId || '',\n    sender_email: extractEmail(fromRaw),\n    subject: j.Subject || j.subject || '',\n    question:\n      j.textPlain ||\n      j.text ||\n      j.snippet ||\n      j.body ||\n      ''\n  }\n}];"
      },
