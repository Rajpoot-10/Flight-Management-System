    {
      "parameters": {
        "jsCode": "const refund = $('Get Pending Refunds Older Than 3 Days').item.json;\nconst booking = $('Get Booking').item.json;\nconst passenger = $json;\n\nconst requestedAt = new Date(refund.requested_at);\nconst now = new Date();\nconst pendingDays = Math.max(\n  0,\n  Math.floor((now - requestedAt) / (24 * 60 * 60 * 1000))\n);\n\nreturn [{\n  json: {\n    refund_id: refund.refund_id,\n    booking_id: refund.booking_id,\n    passenger_id: refund.passenger_id,\n    passenger_name: passenger.full_name || 'Unknown',\n    passenger_email: passenger.email || 'Unknown',\n    flight_id: booking.flight_id,\n    refund_amount: Number(refund.refund_amount || 0),\n    refund_status: refund.refund_status,\n    refund_type: refund.refund_type,\n    reason: refund.reason || 'No reason recorded',\n    requested_at: refund.requested_at,\n    pending_days: pendingDays\n  }\n}];"
      },
