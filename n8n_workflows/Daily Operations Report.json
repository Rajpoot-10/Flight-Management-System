      "name": "Get Today's Waitlist Activity.",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const flights = $('Get Today\\'s Flights').all();\nconst bookings = $('Get Today\\'s Bookings').all();\nconst refunds = $('Get Today\\'s Refunds.').all();\nconst waitlist = $('Get Today\\'s Waitlist Activity.').all();\n\nconst validFlights = flights.filter(i => i.json.flight_id);\nconst validBookings = bookings.filter(i => i.json.booking_id);\nconst validRefunds = refunds.filter(i => i.json.refund_id);\nconst validWaitlist = waitlist.filter(i => i.json.waitlist_id);\n\nconst totalRevenue = validBookings\n  .filter(i => i.json.payment_status === 'paid')\n  .reduce((sum, i) => sum + Number(i.json.total_amount || 0), 0);\n\nconst totalRefunds = validRefunds\n  .reduce((sum, i) => sum + Number(i.json.refund_amount || 0), 0);\n\nconst confirmedBookings = validBookings\n  .filter(i => i.json.booking_status === 'confirmed').length;\n\nconst cancelledBookings = validBookings\n  .filter(i => i.json.booking_status === 'cancelled').length;\n\nconst waitingPassengers = validWaitlist\n  .filter(i => i.json.waitlist_status === 'waiting').length;\n\nconst offeredPassengers = validWaitlist\n  .filter(i => i.json.waitlist_status === 'offered').length;\n\nreturn [\n  {\n    json: {\n      report_date: new Date().toLocaleDateString('en-PK'),\n      total_flights: validFlights.length,\n      total_bookings: validBookings.length,\n      confirmed_bookings: confirmedBookings,\n      cancelled_bookings: cancelledBookings,\n      total_revenue: totalRevenue,\n      total_refunds: totalRefunds,\n      net_revenue: totalRevenue - totalRefunds,\n      waitlist_entries: validWaitlist.length,\n      waiting_passengers: waitingPassengers,\n      offered_passengers: offeredPassengers\n    }\n  }\n];"
      },
