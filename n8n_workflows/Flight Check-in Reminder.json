      "name": "Get Upcoming Confirmed Bookings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -656,
        80
      ],
      "id": "962e76bf-800e-4604-a28a-bfbfe4359c6c",
      "notes": "IMPORTANT: enable 'Split Into Items' under Options so each booking becomes its own item. Supabase returns one JSON array otherwise."
    },
    {
      "parameters": {
        "url": "https://tzrruikgdomkqijawsog.supabase.co/rest/v1/flights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "flight_id",
              "value": "=eq.{{$json.flight_id}}"
            },
            {
              "name": "flight_status",
              "value": "eq.scheduled"
            },
            {
              "name": "select",
              "value": "flight_id,flight_number,origin,destination,departure_time,arrival_time"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "secretkey here"
            },
            {
              "name": "Authorization",
              "value": "=Bearer secretkey here"
            }
          ]
        },
        "options": {}
      },
      "name": "Get Flight Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -448,
        80
      ],
      "id": "d62c82bd-92d3-44c1-a248-1c21612cacf4",
      "notes": "Runs once per booking item. Cancelled flights are excluded here since flight_status=eq.scheduled returns nothing for them, so the IF below naturally drops those bookings."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ new Date($json.departure_time).getTime() }}",
              "rightValue": "={{ Date.now() }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "id": "cda2df5a-c5fd-46e4-8980-b25878c68510"
            },
            {
              "leftValue": "={{ new Date($json.departure_time).getTime() }}",
              "rightValue": "={{ Date.now() + 24*60*60*1000 }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              },
              "id": "c67be337-59bb-4bdf-afa1-bc3491a12d81"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Departs Within 24h?",
