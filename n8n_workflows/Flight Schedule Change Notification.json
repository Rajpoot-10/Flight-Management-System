    {
      "parameters": {
        "jsCode": "const passenger = $json;\nconst booking = $('Get Confirmed Bookings').item.json;\nconst flight = $('Get Updated Flight').item.json;\nconst audit = $('Get Unprocessed Schedule Changes').item.json;\n\nconst oldDeparture = audit.old_data?.departure_time || 'Unknown';\nconst oldArrival = audit.old_data?.arrival_time || 'Unknown';\nconst newDeparture = audit.new_data?.departure_time || flight.departure_time || 'Unknown';\nconst newArrival = audit.new_data?.arrival_time || flight.arrival_time || 'Unknown';\n\nreturn [{\n  json: {\n    audit_id: audit.audit_id,\n    booking_id: booking.booking_id,\n    flight_id: flight.flight_id,\n    passenger_id: passenger.passenger_id,\n    passenger_name: passenger.full_name,\n    passenger_email: passenger.email,\n    flight_number: flight.flight_number,\n    origin: flight.origin,\n    destination: flight.destination,\n    old_departure_time: oldDeparture,\n    old_arrival_time: oldArrival,\n    new_departure_time: newDeparture,\n    new_arrival_time: newArrival\n  }\n}];"
      },
      "id": "4accdd26-cf00-4840-a482-6332fce6ac38",
      "name": "Prepare Schedule Change Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        560
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.passenger_email }}",
        "subject": "=Flight Schedule Changed - {{ $json.flight_number }}",
        "message": "=Hello {{ $json.passenger_name }},\\n\\nThe schedule for your flight {{ $json.flight_number }} from {{ $json.origin }} to {{ $json.destination }} has changed.\\n\\nPrevious departure: {{ $json.old_departure_time }}\\nNew departure: {{ $json.new_departure_time }}\\n\\nPrevious arrival: {{ $json.old_arrival_time }}\\nNew arrival: {{ $json.new_arrival_time }}\\n\\nBooking ID: {{ $json.booking_id }}\\n\\nPlease review the updated schedule before travel.\\n\\nFlight Management System",
        "options": {
          "appendAttribution": false
        }
