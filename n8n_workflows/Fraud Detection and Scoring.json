      "id": "dc7c056e-0e77-4f1f-a6f9-4c4975ba72e8",
      "name": "Get Passenger Recent Bookings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        304
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const booking = $('Get Booking Details').first().json;\nconst recent = $('Get Passenger Recent Bookings').all().map(i => i.json);\n\nlet score = 0;\nconst reasons = [];\n\nconst amount = Number(booking.total_amount || 0);\nconst recentCount = recent.length;\nconst recentTotal = recent.reduce((sum, r) => sum + Number(r.total_amount || 0), 0);\n\nif (amount >= 100000) {\n  score += 35;\n  reasons.push('unusually high booking amount');\n} else if (amount >= 50000) {\n  score += 20;\n  reasons.push('high booking amount');\n}\n\nif (recentCount >= 5) {\n  score += 30;\n  reasons.push('multiple bookings within the last 24 hours');\n} else if (recentCount >= 3) {\n  score += 15;\n  reasons.push('elevated booking frequency within the last 24 hours');\n}\n\nif (recentTotal >= 200000) {\n  score += 25;\n  reasons.push('high cumulative booking value within the last 24 hours');\n}\n\nif (String(booking.payment_status).toLowerCase() !== 'paid') {\n  score += 20;\n  reasons.push('booking is not fully paid');\n}\n\nif (String(booking.fare_type).toLowerCase() === 'flexible' && amount >= 75000) {\n  score += 10;\n  reasons.push('high-value flexible fare booking');\n}\n\nscore = Math.min(score, 100);\n\nlet risk_level = 'low';\nif (score >= 70) risk_level = 'high';\nelse if (score >= 40) risk_level = 'medium';\n\nreturn [{\n  json: {\n    booking_id: booking.booking_id,\n    passenger_id: booking.passenger_id,\n    fraud_score: score,\n    risk_level,\n    risk_reasons: reasons,\n    review_status: risk_level === 'high' ? 'pending' : 'cleared'\n  }\n}];"
      },
