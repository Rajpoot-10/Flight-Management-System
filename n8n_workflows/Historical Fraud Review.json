      "id": "48786bc2-c7be-4153-87d4-a393be85adea",
      "name": "Get Medium and High Risk Cases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        256,
        432
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.all().map(i => i.json);\n\n// Remove empty placeholder items like {}\nconst cases = raw.filter(c =>\n  c &&\n  Object.keys(c).length > 0 &&\n  c.booking_id !== undefined\n);\n\nif (cases.length === 0) {\n  return [{\n    json: {\n      has_cases: false,\n      subject: 'Weekly Fraud Review - No Medium/High Risk Cases',\n      report:\n        'WEEKLY FRAUD REVIEW REPORT\\n\\n' +\n        'No medium or high-risk fraud assessments are currently available for review.'\n    }\n  }];\n}\n\nconst pending = cases.filter(c => c.review_status === 'pending');\nconst high = cases.filter(c => c.risk_level === 'high');\nconst medium = cases.filter(c => c.risk_level === 'medium');\n\nlet report = `WEEKLY FRAUD REVIEW REPORT\\n\\n`;\nreport += `Total cases: ${cases.length}\\n`;\nreport += `High risk: ${high.length}\\n`;\nreport += `Medium risk: ${medium.length}\\n`;\nreport += `Pending human review: ${pending.length}\\n\\n`;\nreport += `----------------------------------------\\n`;\n\nfor (const c of cases) {\n  const reasons = Array.isArray(c.risk_reasons)\n    ? c.risk_reasons.join(', ')\n    : String(c.risk_reasons || 'No reasons recorded');\n\n  report += `\\nBooking #${c.booking_id}\\n`;\n  report += `Passenger ID: ${c.passenger_id}\\n`;\n  report += `Fraud Score: ${c.fraud_score}/100\\n`;\n  report += `Risk Level: ${String(c.risk_level).toUpperCase()}\\n`;\n  report += `Reasons: ${reasons}\\n`;\n  report += `Review Status: ${c.review_status}\\n`;\n  report += `Assessed At: ${c.created_at}\\n`;\n  report += `----------------------------------------\\n`;\n}\n\nreturn [{\n  json: {\n    has_cases: true,\n    subject: `Weekly Fraud Review - ${high.length} High / ${medium.length} Medium Risk`,\n    report\n  }\n}];"
      },
